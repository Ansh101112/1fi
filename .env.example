# --- Neon Postgres -----------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# --- Neon Auth ---------------------------------------------------------------
# Auth route root of the hosted Neon Auth instance for this project.
# Shape: https://<endpoint-id>.neonauth.<region>/<database>/auth
NEON_AUTH_BASE_URL="https://<endpoint-id>.neonauth.<region>.aws.neon.tech/<database>/auth"

# Signs the local session_data cookie. Must be at least 32 characters.
NEON_AUTH_COOKIE_SECRET="generate with: openssl rand -hex 32"
